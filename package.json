{
  "name": "vettrack",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@vettrack/contracts": "file:.vendor/vettrack/packages/contracts",
    "@vettrack/shared": "file:.vendor/vettrack/shared",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nfc-manager": "3.17.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-performance": "^6.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eas-cli": "22.0.0",
    "eslint": "~9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchman=false --forceExit",
    "typecheck": "tsc --noEmit",
    "vendor:vettrack": "node scripts/vendor-vettrack.mjs",
    "preinstall": "node scripts/vendor-vettrack.mjs",
    "postinstall": "patch-package",
    "lint": "eslint . --max-warnings=0",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:offline": "node scripts/release-preflight.mjs --offline"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|@vettrack|uniwind|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testTimeout": 20000,
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.vendor/",
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
