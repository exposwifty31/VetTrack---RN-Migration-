{
  "name": "vettrack",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "@vettrack/contracts": "file:.vendor/vettrack/packages/contracts",
    "@vettrack/shared": "file:.vendor/vettrack/shared",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nfc-manager": "3.17.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "1.2.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchman=false",
    "typecheck": "tsc --noEmit",
    "vendor:vettrack": "node scripts/vendor-vettrack.mjs",
    "preinstall": "node scripts/vendor-vettrack.mjs",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.vendor/",
      "<rootDir>/.worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
