# Clerk (required for Slice 3+ sign-in). Never commit real keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# API origin for Slice 4+ (absolute URL on device)
EXPO_PUBLIC_API_ORIGIN=http://localhost:3001

# Use RN native fetch (avoid expo/fetch large-response race on Android)
EXPO_PUBLIC_USE_RN_FETCH=1

# Dev-only client seam (src/lib/dev-auth.ts). Set to 1 ONLY when driving a
# simulator/emulator against a server already running in dev-bypass.
#
# This is a FLAG, not a credential, and deliberately so. Expo inlines every
# EXPO_PUBLIC_* value into the bundle in plain text — "Do not store sensitive
# info, such as private keys, in EXPO_PUBLIC_ variables. These variables will be
# visible in plain-text in your compiled application."
# (https://docs.expo.dev/guides/environment-variables/). So nothing credential-
# shaped is ever read from config: the seam uses a fixed placeholder compiled
# into dev-auth.ts that declares alg:none and carries no claims.
#
# Not an auth bypass: __DEV__ only, opt-in, REFUSED when
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY above is set, and it writes only the
# fallback slot (a real Clerk session always wins). The server still
# authenticates — a Clerk-backed server rejects the placeholder with 401 like
# any other garbage. All it buys you is that `authFetch` stops failing closed
# before dispatch, so the request actually reaches the server.
EXPO_PUBLIC_DEV_AUTH=
