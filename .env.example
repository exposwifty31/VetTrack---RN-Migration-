# Clerk (required for Slice 3+ sign-in). Never commit real keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# API origin for Slice 4+ (absolute URL on device)
EXPO_PUBLIC_API_ORIGIN=http://localhost:3001

# Use RN native fetch (avoid expo/fetch large-response race on Android)
EXPO_PUBLIC_USE_RN_FETCH=1

# Dev-only bearer fallback (src/lib/dev-auth.ts). Leave EMPTY unless you are
# driving a simulator/emulator against a server already running in dev-bypass.
#
# It is not an auth bypass: __DEV__ only, opt-in, REFUSED when
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY above is set, and it writes only the
# fallback slot (a real Clerk session always wins). The server still
# authenticates — against a Clerk-backed server this value is rejected with 401
# like any other garbage. What it buys you is that `authFetch` stops failing
# closed before dispatch, so the request actually reaches the server.
#
# Must be a syntactically valid 3-segment JWT or it is refused. A dev-bypass
# server reads no claims from it, so any well-formed placeholder works.
EXPO_PUBLIC_DEV_BEARER_TOKEN=
