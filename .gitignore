.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Git worktrees (agent isolation)
.worktrees/

# Agent scaffolding — non-source, already excluded by eslint.config.js and by jest's
# modulePathIgnorePatterns. `.claude/worktrees/` holds LIVE linked git worktrees (multi-MB sibling
# checkouts) that sit inside this repo directory; without this rule a single `git add -A` stages an
# entire sibling checkout for the next commit. `settings.local.json` is per-machine and is never shared.
#
# Deliberately NOT a blanket `.claude/*`: the sibling vettrack repo tracks agent config under
# `.claude/agents|commands|skills|rules`, and a blanket rule would make `git add -A` silently skip
# those here if this repo ever adopts the same convention. Ignore the two known-unshareable paths
# only. `.claude/settings.json` stays tracked (`git ls-files .claude/`).
.claude/worktrees/
.claude/settings.local.json

# Store credentials (never commit; *.p8 is covered above)
google-service-account.json
credentials.json
# Firebase client config (owner-supplied; provided to EAS as a file env var)
google-services.json

# Pinned vettrack checkout for @vettrack/* file: deps (see scripts/vendor-vettrack.mjs)
.vendor/
docs/vettrack-g4-g5-slice13-verified.md

# Claim-verification evidence (scripts/verify-evidence.mjs). Deliberately NOT
# committed: the report is bound to a tree hash, so a committed one would be
# stale the moment the next commit lands. CI regenerates it before the gate runs.
docs/audit/evidence-run.json

# Fixtures the claims-ledger suite creates in the repository root to prove that
# a symlink cannot escape the checkout. They are removed in `finally`, but a run
# killed mid-test would leave one behind — and `verify:evidence` reads
# `git status --porcelain`, so an untracked leftover marks the tree DIRTY and
# invalidates the evidence report that follows.
/.vt-symlink-probe-*
/vt-glob-probe-*
